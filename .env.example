# === Firebase Client Config (Vite — VITE_ prefix exposes these to the browser) ===
# Copy this to .env.local or set on your VPS with real values.
# Never commit real Firebase keys to Git.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_FIRESTORE_DB_ID=(default)
VITE_FIREBASE_MEASUREMENT_ID=

# === Gemini AI ===
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# === App URL (used for OAuth callbacks, API endpoints) ===
APP_URL=https://your-domain.com

# === PostgreSQL (optional) ===
DATABASE_URL=
